{
  "compilerOptions": {
    "module": "ESNext",
    "target": "es2022",
    "noImplicitAny": true,
    "strict": true,
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist"
  },

  "ts-node": {
    "esm": true,
    "transpileOnly": true,
    "experimentalSpecifierResolution": "node",
    "preferTsExts": true
  },

  "include": ["src"]
}
